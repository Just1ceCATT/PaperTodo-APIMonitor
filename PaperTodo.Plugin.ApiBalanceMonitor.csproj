<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- 宿主协议：独立仓库编译时引用宿主仓库中的 PaperTodo.Plugin.Abstractions。 -->
    <ProjectReference Include="..\PaperTodo\PaperTodo.Plugin.Abstractions\PaperTodo.Plugin.Abstractions.csproj" />
    <!-- WebView2：监视面板用 HTML 渲染；宿主已内置同名程序集，插件只声明依赖。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <!-- 测试工程是独立的 net10.0 工程，不要并入主工程的默认 Compile glob，
       否则会引入 System.IO（导致 Path 歧义）、xUnit 引用缺失等错误。 -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
  </ItemGroup>
</Project>
